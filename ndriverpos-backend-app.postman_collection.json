9\",\r\n            \"labelFontSize\": \"14px\",\r\n            \"labelFontWeight\": \"600\",\r\n            \"placeholder\": \"Enter Password\",\r\n            \"placeholderColor\": \"#6B7280\",\r\n            \"borderColor\": \"#E5E7EB\",\r\n            \"borderRadius\": \"10px\",\r\n            \"focusBorderColor\": \"#7FB069\",\r\n            \"background\": \"#FFFFFF\",\r\n            \"fontSize\": \"14px\",\r\n            \"showToggleIcon\": true,\r\n            \"toggleIconColor\": \"#6B7280\"\r\n        },\r\n        \"loginButton\": {\r\n            \"text\": \"Login\",\r\n            \"background\": \"#7FB069\",\r\n            \"textColor\": \"#FFFFFF\",\r\n            \"fontSize\": \"16px\",\r\n            \"fontWeight\": \"700\",\r\n            \"height\": \"52px\",\r\n            \"borderRadius\": \"10px\",\r\n            \"width\": \"100%\"\r\n        },\r\n        \"errorText\": {\r\n            \"color\": \"#C01C2D\",\r\n            \"fontSize\": \"13px\",\r\n            \"fontWeight\": \"500\"\r\n        }\r\n    },\r\n    \"isVisible\": true\r\n}",
